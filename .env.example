# Copy this file to .env and fill in real values. .env is gitignored and
# must never be committed.

# Space-Track.org account credentials (used by services/poller)
SPACETRACK_IDENTITY=your_spacetrack_username_or_email
SPACETRACK_PASSWORD=your_spacetrack_password

# Postgres connection string (used by both poller and api)
# e.g. postgresql://user:pass@host:5432/dbname?sslmode=require
DATABASE_URL=

# Port the api service listens on (optional, defaults to 8080)
API_PORT=8080

# Comma-separated list of origins allowed to call the api service from a
# browser (optional). If unset, defaults to the production frontend, Vercel
# preview deployments, and the typical Vite dev server port -- see
# services/api/cors_middleware.cpp.
CORS_ALLOWED_ORIGINS=https://vitaleaerospace.com,https://vitale-frontend.vercel.app,http://localhost:5173
