# Copy this file to .env and fill in real values. .env is gitignored and
# must never be committed.

# Space-Track.org account credentials (used by services/poller)
SPACETRACK_IDENTITY=your_spacetrack_username_or_email
SPACETRACK_PASSWORD=your_spacetrack_password

# Postgres connection string (used by both poller and api)
# e.g. postgresql://user:pass@host:5432/dbname?sslmode=require
DATABASE_URL=

# Port the api service listens on (optional, defaults to 8080)
API_PORT=8080
